# Lovable Cloud / Supabase auto-managed values.
# The real .env is generated by the integration at runtime and should NOT be
# committed. Only these publishable values belong here as placeholders.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Server-only secrets (set via Lovable Cloud Secrets, NEVER commit values):
# - SUPABASE_SERVICE_ROLE_KEY  (managed by integration)
# - CRON_SECRET                (required by /api/public/hooks/* guard)
# - LOVABLE_API_KEY            (managed by AI Gateway)

# --- MCP OAuth (optional override) ---
# Optional build-time full-URL override for /mcp OAuth issuer.
# Must be the direct Supabase auth issuer, e.g. https://<ref>.supabase.co/auth/v1
# Leave unset in normal setups — issuer is derived from VITE_SUPABASE_URL.
# VITE_MCP_OAUTH_ISSUER=

# --- QA-MCP (test harness, disabled by default) ---
# BUILD-time flag: controls whether qa_* tools are registered in the MCP
# manifest and Worker bundle. Must be set at build time (Vite inlines it).
# When "false" or unset, only `echo` is exposed and no qa_* tool is reachable.
VITE_QA_MCP_TOOLS_ENABLED=false

# RUNTIME gates (read inside tool handlers; safe to change without rebuild).
# Master runtime switch reported by qa_whoami. When "false" the tool still
# exists (if VITE_QA_MCP_TOOLS_ENABLED=true) but reports qa_mcp_enabled=false.
QA_MCP_ENABLED=false
# Comma-separated Supabase project refs where QA-MCP is permitted to run.
# Compared against ref parsed from SUPABASE_URL or QA_SUPABASE_PROJECT_REF.
QA_MCP_ALLOWED_PROJECT_REFS=
# Optional explicit project-ref override for the QA gate.
# Falls back to parsing SUPABASE_URL when unset.
QA_SUPABASE_PROJECT_REF=
# Comma-separated auth.users.id values allowed to invoke QA-MCP tools.
# Empty = QA tools refuse for everyone.
QA_MCP_ADMIN_USER_IDS=
